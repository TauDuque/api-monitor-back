generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // Hash bcrypt
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  monitoredUrls MonitoredURL[]
  refreshTokens RefreshToken[]

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model MonitoredURL {
  id        String   @id @default(uuid())
  userId    String // Nova coluna para multi-tenant
  url       String
  name      String
  interval  Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertConfigurations AlertConfiguration?
  incidents           Incident[]
  checks              URLCheck[]

  @@unique([userId, url]) // Usuário não pode duplicar URL
  @@index([userId])
}

model URLCheck {
  id             String       @id @default(uuid())
  monitoredUrlId String
  status         Int
  responseTime   Int
  isOnline       Boolean
  checkedAt      DateTime     @default(now())
  monitoredUrl   MonitoredURL @relation(fields: [monitoredUrlId], references: [id], onDelete: Cascade)
}

model Incident {
  id             String       @id @default(uuid())
  monitoredUrlId String
  type           String
  description    String?
  startedAt      DateTime     @default(now())
  resolvedAt     DateTime?
  monitoredUrl   MonitoredURL @relation(fields: [monitoredUrlId], references: [id], onDelete: Cascade)
}

model AlertConfiguration {
  id             String       @id @default(uuid())
  monitoredUrlId String       @unique
  emailRecipient String?
  webhookUrl     String?
  notifyOnDown   Boolean      @default(true)
  notifyOnUp     Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  monitoredUrl   MonitoredURL @relation(fields: [monitoredUrlId], references: [id], onDelete: Cascade)
}
